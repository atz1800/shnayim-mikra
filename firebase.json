{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "!**/.well-known", "!**/.well-known/**", "**/node_modules/**"],
    "predeploy": ["npm run build"],
    "headers": [
      {
        "source": "sw.js",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      }
    ]
  }
}
